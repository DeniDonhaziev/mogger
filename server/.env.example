# Скопируйте этот файл в .env и заполните значения.

# Строка подключения к PostgreSQL.
# Проще всего бесплатно взять на https://neon.tech (Postgres в облаке, без установки).
# Пример: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Секрет для подписи JWT-токенов (придумайте длинную случайную строку).
JWT_SECRET=change-me-to-a-long-random-string

# Порт сервера (для локального запуска).
PORT=4000

# Разрешённый источник фронтенда (CORS). Для локалки — адрес Vite.
CLIENT_ORIGIN=http://localhost:5173
